[Unit]
Description=CV Screening & Ranking Platform - FastAPI REST Backend & Frontend (Port 8110)
After=network.target postgresql.service

[Service]
Type=simple
User=alifihsan
Group=alifihsan
WorkingDirectory=/home/alifihsan/agentic-cv-screener
Environment=PATH=/home/alifihsan/agentic-cv-screener/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/home/alifihsan/agentic-cv-screener
EnvironmentFile=/home/alifihsan/agentic-cv-screener/.env
ExecStart=/home/alifihsan/agentic-cv-screener/.venv/bin/uvicorn src.api.main:app --host 127.0.0.1 --port 8110 --workers 2 --proxy-headers --forwarded-allow-ips="127.0.0.1" --access-log
Restart=always
RestartSec=5s

# Resource Constraints
LimitNOFILE=65536
PrivateTmp=true

[Install]
WantedBy=multi-user.target
