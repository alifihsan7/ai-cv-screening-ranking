[Unit]
Description=CV Screening & Ranking Platform - Async Queue Worker
After=network.target postgresql.service

[Service]
Type=simple
User=alifihsan
Group=alifihsan
WorkingDirectory=/home/alifihsan/agentic-cv-screener
Environment=PATH=/home/alifihsan/agentic-cv-screener/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/home/alifihsan/agentic-cv-screener
EnvironmentFile=/home/alifihsan/agentic-cv-screener/.env
ExecStart=/home/alifihsan/agentic-cv-screener/.venv/bin/python -m src.worker.main
Restart=always
RestartSec=5s

# Resource Constraints
LimitNOFILE=65536
PrivateTmp=true

[Install]
WantedBy=multi-user.target
