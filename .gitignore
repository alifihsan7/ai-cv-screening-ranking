# Git Ignore for CV Screening & Ranking Platform

# Environment & secrets
.env
*.env
*.pem
*.key

# Virtual environments & python cache
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/
.mypy_cache/
.ruff_cache/

# Storage & Private Data
data/
/data/
docs/spec/golden_dataset/private/
*.pdf
!docs/research/*.pdf
*.docx
*.doc

# Logs & Temporary Files
logs/
*.log
tmp/
/tmp/

# Dokumen yang dihasilkan dari .md oleh scripts/compile_*_pdf.py (pandoc + typst): bangun ulang, jangan di-commit
docs/spec/CETAK_BIRU_ARSITEKTUR_SISTEM_JEV.typ
